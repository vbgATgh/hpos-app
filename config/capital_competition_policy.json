    "priceMomentumNeverCountsAsStandaloneAdvantage":true,
    "ownershipNeverCountsAsAdvantage":true
  },
  "outcomes":["BEST_NEW_MONEY_DESTINATION","BEST_ROTATION","NO_CLEAR_ADVANTAGE","WAIT","BLOCKED"],
  "guardrails":["NO_AUTONOMOUS_TRADES","NO_WEIGHTED_PSEUDO_PRECISION","NO_FORCED_INVESTMENT","NO_ASSET_FAVORITES","USER_FINAL_AUTHORITY"]
