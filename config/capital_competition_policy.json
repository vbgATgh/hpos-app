    "cashHardFloorBlocksPurchase":true,
    "unknownTradeabilityBlocksExecution":true
  },
  "evidenceStates":{
    "BROKEN":"BLOCK",
    "WEAKENING":"DO_NOT_ADD_UNLESS_REVIEW_RESOLVES",
    "NEUTRAL":"ELIGIBLE_IF_OTHER_GATES_PASS",
    "STRENGTHENING":"ELIGIBLE_IF_OTHER_GATES_PASS",
    "INSUFFICIENT":"WAIT_FOR_EVIDENCE"
