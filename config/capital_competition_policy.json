{
  "schemaVersion":1,
  "version":"1.0",
  "principle":"THE_NEXT_EURO_HAS_NO_LOYALTY",
  "eligibilityOrder":["HALAL","DATA_SUFFICIENCY","PORTFOLIO_CAPS","CASH","TRADEABILITY","THESIS_EVIDENCE","VALUATION_WHEN_AVAILABLE","EXECUTION"],
  "hardBlocks":{
